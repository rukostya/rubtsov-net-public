# Canonical entrypoints. THE_REQUEST prevents redirecting internal DirectoryIndex requests.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{THE_REQUEST} \s/+index\.htm(?:[?\s]) [NC]
  RewriteRule ^index\.htm$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
</IfModule>
